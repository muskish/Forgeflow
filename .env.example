# Nhost & Hasura Configuration
NHOST_SUBDOMAIN=local
NHOST_REGION=local
NHOST_ADMIN_SECRET=nhost-admin-secret
NHOST_WEBHOOK_SECRET=nhost-webhook-secret-key-12345
NHOST_JWT_SECRET={"type":"HS256","key":"nhost-jwt-secret-key-must-be-at-least-32-chars-long"}

# LLM Configuration (Groq / OpenRouter / Gemini)
LLM_PROVIDER=groq # groq | openrouter | gemini | stub
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# Public Frontend Environment Variables
NEXT_PUBLIC_NHOST_SUBDOMAIN=local
NEXT_PUBLIC_NHOST_REGION=local
NEXT_PUBLIC_NHOST_BACKEND_URL=http://localhost:1337
NEXT_PUBLIC_HASURA_GRAPHQL_URL=http://localhost:1337/v1/graphql
NEXT_PUBLIC_HASURA_WS_URL=ws://localhost:1337/v1/graphql
